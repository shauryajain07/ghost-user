# Copy this file to .env. Keep the real key local and never commit it.
TYPESAFE_API_KEY=your_typesafe_api_key_here
# JEV_API_KEY=your_typesafe_api_key_here
# Hidden browser sessions are the default. Set to 0 to open Chrome visibly.
GHOST_USER_HEADLESS=1
# Full action mode is disabled unless explicitly enabled and allowlisted.
# GHOST_USER_ALLOW_PROTECTED_ACTIONS=0
# GHOST_USER_PROTECTED_HOSTS=localhost,staging.example.com
